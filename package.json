{
  "name": "perkusi-com",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "node scripts/local-build.mjs --mode gamelan-v5-canonical-release",
    "build:v5": "node scripts/local-build.mjs --mode gamelan-v5-ux --outDir qa-artifacts/v5-current-build",
    "cleanup:builds": "node scripts/build-housekeeping.mjs",
    "build:gamelan-candidate": "node scripts/build-gamelan-candidate.mjs",
    "build:gamelan-public": "node scripts/build-gamelan-public.mjs",
    "preview": "vite preview --host 127.0.0.1",
    "lint": "eslint .",
    "check": "npm run lint && npm run build",
    "test": "node --test tests/*.test.js",
    "test:e2e": "node scripts/test-browser.mjs",
    "fixtures:audio": "python scripts/make-audio-fixtures.py",
    "build:audio-prototype": "node scripts/local-build.mjs --mode audio-prototype --outDir qa-artifacts/audio-prototype-current",
    "test:audio": "node scripts/test-audio.mjs",
    "format": "prettier --write index.html 404.html privacy.html en beatbox studio src tests scripts/test-browser.mjs public/privacy.css vite.config.js eslint.config.js package.json README.md"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.12.0",
    "globals": "^17.13.0",
    "prettier": "^3.9.9",
    "vite": "^8.3.2"
  },
  "dependencies": {
    "@fontsource-variable/dm-sans": "^5.3.0",
    "@fontsource-variable/space-grotesk": "^5.3.0"
  }
}
