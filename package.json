{
  "name": "perkusi-com",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "node scripts/local-build.mjs --mode retirement-release",
    "cleanup:builds": "node scripts/build-housekeeping.mjs",
    "preview": "vite preview --host 127.0.0.1",
    "lint": "eslint .",
    "check": "npm run lint && npm run build",
    "test": "node --test tests/*.test.js",
    "test:e2e": "node scripts/test-browser.mjs",
    "test:instruments": "node scripts/test-instrument-articles.mjs",
    "test:tutorials": "node scripts/test-beginner-tutorials.mjs",
    "test:tutorials:desktop": "node scripts/test-desktop-tutorials.mjs",
    "test:wav": "node scripts/test-wav-parity.mjs",
    "test:projects": "node scripts/test-project-roundtrip.mjs",
    "test:transfer": "node scripts/test-mode-transfer.mjs",
    "test:recovery": "node scripts/test-mode-transfer.mjs --recovery",
    "test:clear-backups": "node scripts/test-mode-transfer.mjs --clear-backups",
    "test:delete-projects": "node scripts/test-mode-transfer.mjs --delete-projects",
    "test:load-projects": "node scripts/test-mode-transfer.mjs --load-projects",
    "test:reset-projects": "node scripts/test-project-reset.mjs",
    "fixtures:audio": "python scripts/make-audio-fixtures.py",
    "format": "prettier --write index.html 404.html privacy.html en beatbox studio src tests scripts/test-browser.mjs public/privacy.css vite.config.js eslint.config.js package.json README.md"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.12.0",
    "globals": "^17.13.0",
    "prettier": "^3.9.9",
    "vite": "^8.3.2"
  },
  "dependencies": {
    "@fontsource-variable/dm-sans": "^5.3.0",
    "@fontsource-variable/space-grotesk": "^5.3.0"
  }
}
